# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep Kotlin Serialization models
-keepattributes *Annotation*, EnclosingMethod, Signature
-keepclassmembers class ** {
    @kotlinx.serialization.Serializable *;
}
-keepclassmembers class by.jadjer.etcu.domain.model.** {
    *;
}
-keep class by.jadjer.etcu.domain.model.** { *; }

# Keep DTOs if they are not explicitly marked but used by Retrofit/Serialization
-keep class by.jadjer.etcu.data.network.model.** { *; }
